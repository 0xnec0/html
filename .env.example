# Multi-DEX Trading Bot Configuration
# Copy this file to .env and fill in your credentials

# Paradex Configuration
PARADEX_ENV=TESTNET  # or MAINNET

# For NEW accounts (L1 authentication):
PARADEX_L1_ADDRESS=0x...  # Ethereum L1 address (42 chars, 0x + 40 hex)
PARADEX_L1_PRIVATE_KEY=0x...  # Ethereum L1 private key

# For EXISTING accounts (L2 authentication):
# Keep PARADEX_L1_ADDRESS above, but replace L1_PRIVATE_KEY with:
# PARADEX_L2_PRIVATE_KEY=0x...  # Your L2 private key from Paradex

PARADEX_MARKET=JUP-USD-PERP

# Lighter Configuration
# Get your account index: https://mainnet.zklighter.elliot.ai/api/v1/accountsByL1Address?l1_address=0x...
LIGHTER_PRIVATE_KEY=0x...  # API key private key for signing
LIGHTER_ACCOUNT_INDEX=0  # Your account index from API
LIGHTER_API_KEY_INDEX=2  # API key index (2-254, default 2)
LIGHTER_MARKET=JUP
LIGHTER_USE_WEBSOCKET=true  # Use WebSocket for fill detection (true/false)

# Proxy Configuration (Optional but recommended for production)
USE_PROXY=false  # Set to true to enable proxy
PROXY_SERVER=as.smartproxy.net
PROXY_PORT=3120
PROXY_USERNAME=your_username
PROXY_PASSWORD=your_password

# Trading Configuration
TRADE_AMOUNT=0.1
SLIPPAGE_TOLERANCE=0.5
EXECUTION_TIMEOUT=30

# Delta Neutral Strategy Configuration
DELTA_NEUTRAL_USD_AMOUNT=50  # Fixed USD amount per position (e.g., 50 for $50)
DELTA_NEUTRAL_LEVERAGE=10  # Leverage multiplier (default: 10x)
DELTA_NEUTRAL_CAPITAL_PCT=0.5  # Percentage of capital to use (default: 0.5 = 50%)
DELTA_NEUTRAL_MIN_HOURS=2.0  # Minimum hold time in hours
DELTA_NEUTRAL_MAX_HOURS=3.0  # Maximum hold time in hours

# Spread Monitoring Configuration
SPREAD_MAX_PCT=0.02  # Maximum allowed bid-ask spread for EACH exchange (e.g., 0.02 = 0.02%)
SPREAD_CHECK_INTERVAL=2  # Check interval in seconds (default: 2 seconds)
SPREAD_CHECK_TIMEOUT=0  # Timeout in seconds (0 = infinite, wait until condition is met)

# Funding Rate Arbitrage Configuration
FUNDING_RATE_ENABLED=true  # Enable funding rate arbitrage strategy (true/false)
FUNDING_RATE_MIN_DIFF_PCT=0.5  # Minimum funding rate difference to trigger position (in %, e.g., 0.5 = 0.5%)
FUNDING_RATE_CHECK_INTERVAL=300  # Check funding rates every N seconds (default: 300 = 5 minutes)
FUNDING_RATE_TARGET_APY=10.0  # Target annual percentage yield (e.g., 10.0 = 10% APY)

# Discord Notifications (Optional)
# Get webhook URL from Discord: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...  # Discord webhook URL for notifications
