# DOGE Trading Bot Configuration
# Copy this file to .env and fill in your credentials

# Paradex Configuration
PARADEX_ENV=TESTNET  # or MAINNET
PARADEX_L1_ADDRESS=0x...
PARADEX_L1_PRIVATE_KEY=0x...
# For existing Paradex accounts, use L2 credentials instead:
# PARADEX_L2_ADDRESS=0x...
# PARADEX_L2_PRIVATE_KEY=0x...
PARADEX_MARKET=DOGE-USD-PERP

# Lighter Configuration
LIGHTER_API_KEY=your_api_key_here
LIGHTER_API_SECRET=your_api_secret_here
LIGHTER_PRIVATE_KEY=0x...
LIGHTER_MARKET=DOGE

# Trading Configuration
TRADE_AMOUNT=0.1
SLIPPAGE_TOLERANCE=0.5
EXECUTION_TIMEOUT=30
